# =============================================================================
# .credentials.example — contrato de credenciais para o seed do Gris
# =============================================================================
# Como usar:
#   1. Copie este arquivo para .credentials (mesma pasta).
#   2. Preencha com valores reais ou stubs adequados ao ambiente de dev.
#   3. NUNCA comite o .credentials (ja esta no .gitignore).
#
# O script gris/scripts/seed/credentials.py carrega esses valores e usa em:
#   - Configuracoes Singles do app gris (campos Password)
#   - DocTypes nativos do Frappe (Email Account, Google Settings, etc.)
# =============================================================================

# === Configs do app Gris ===
gris:
  configuracoes_llm:
    api_key: ""                     # ex: sk-...

  configuracoes_whatsapp:
    api_key: ""
    phone_number_id: ""
    business_account_id: ""
    webhook_verify_token: ""

  configuracoes_backup_google_drive:
    service_account_json: ""        # JSON inteiro do service account (string)
    pasta_destino_id: ""            # ID da pasta no Drive
    enabled: 0

  configuracoes_feriados:
    feriadosapi_key: ""

  configuracoes_google_workspace:
    domain: "example.com"
    admin_email: "admin@example.com"
    service_account_json: ""

# === Configs nativas do Frappe ===
frappe:
  email_account:
    email_id: "noreply@example.com"
    email_account_name: "Gris Notificacoes"
    password: ""
    smtp_server: "smtp.gmail.com"
    smtp_port: "587"
    use_tls: 1
    enable_outgoing: 1
    default_outgoing: 1

  google_settings:
    enable: 0
    client_id: ""
    client_secret: ""
    api_key: ""
    app_id: ""

  google_drive:
    enable: 0
    backup_folder_name: "GrisBackup"
    frequency: "Weekly"
    email: "admin@example.com"

  social_login_keys:
    - provider_name: "Google"
      social_login_provider: "Google"
      enable_social_login: 0
      client_id: ""
      client_secret: ""
      sign_ups: "Allow"

# === Site / Admin ===
site:
  default_country: "Brazil"
  time_zone: "America/Sao_Paulo"
  language: "pt-BR"
  date_format: "dd/mm/yyyy"
  number_format: "#.###,##"
  currency: "BRL"

  website:
    home_page: "index"
    title_prefix: "GRIS"
    copyright: "Grupo Escoteiro Professora Inah de Mello"
