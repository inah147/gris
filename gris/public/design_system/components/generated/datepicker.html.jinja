{#
  Renders a date picker component with single-date or date-range selection modes.

  @param id {string} [optional] - Unique identifier for the datepicker.
  @param name {string} [optional] - Hidden input name. In `single` mode, used as-is. In `range` mode, used as a prefix and the suffixes `_start` / `_end` are appended.
  @param mode {string} [default="single"] - Selection mode: "single" or "range".
  @param value {string|object} [optional] - Initial value. ISO "YYYY-MM-DD" for `single`; `{"start": "...", "end": "..."}` for `range`.
  @param min {string} [optional] - Minimum selectable ISO date "YYYY-MM-DD".
  @param max {string} [optional] - Maximum selectable ISO date "YYYY-MM-DD".
  @param placeholder {string} [default="Selecione uma data"] - Placeholder shown when no value is selected.
  @param locale {string} [default="pt-BR"] - BCP 47 locale tag used for `Intl.DateTimeFormat`.
  @param main_attrs {object} [optional] - Extra attributes for the wrapper div.
  @param trigger_attrs {object} [optional] - Extra attributes for the trigger button.
#}
{% macro datepicker(
    id=None,
    name=None,
    mode="single",
    value=None,
    min=None,
    max=None,
    placeholder="Selecione uma data",
    locale="pt-BR",
    main_attrs={},
    trigger_attrs={}
) %}
{% set id = id or ("datepicker-" ~ (range(100000, 999999) | random | string)) %}
{% set is_range = mode == "range" %}
{% set value_single = value if (value and not is_range) else "" %}
{% set value_start = (value.start if (is_range and value and value.start) else "") %}
{% set value_end = (value.end if (is_range and value and value.end) else "") %}
<div
  id="{{ id }}"
  class="datepicker {{ main_attrs.class }}"
  data-datepicker
  data-mode="{{ 'range' if is_range else 'single' }}"
  {% if min %}data-min="{{ min }}"{% endif %}
  {% if max %}data-max="{{ max }}"{% endif %}
  data-locale="{{ locale }}"
  data-placeholder="{{ placeholder }}"
  {% for key, val in main_attrs.items() %}
    {% if key != "class" %}{{ key }}="{{ val }}"{% endif %}
  {% endfor %}
>
  <button
    type="button"
    class="datepicker-trigger input {{ trigger_attrs.class }}"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="{{ id }}-popover"
    {% for key, val in trigger_attrs.items() %}
      {% if key != "class" %}{{ key }}="{{ val }}"{% endif %}
    {% endfor %}
  >
    <svg class="ds-lucide ds-lucide--sm datepicker-trigger__icon" viewBox="0 0 24 24" aria-hidden="true">
      <use href="/assets/gris/design_system/icons/lucide/sprite.svg#calendar"></use>
    </svg>
    <span class="datepicker-trigger__label" data-datepicker-label>{{ placeholder }}</span>
  </button>

  {% if is_range %}
    <input type="hidden" data-datepicker-value-start
      {% if name %}name="{{ name }}_start"{% endif %}
      value="{{ value_start }}">
    <input type="hidden" data-datepicker-value-end
      {% if name %}name="{{ name }}_end"{% endif %}
      value="{{ value_end }}">
  {% else %}
    <input type="hidden" data-datepicker-value
      {% if name %}name="{{ name }}"{% endif %}
      value="{{ value_single }}">
  {% endif %}

  <div
    id="{{ id }}-popover"
    class="datepicker-popover"
    data-datepicker-popover
    role="dialog"
    aria-modal="false"
    aria-label="Selecionar data"
    hidden
  >
    <header class="datepicker-popover__header">
      <button type="button" class="datepicker-popover__nav" data-datepicker-prev aria-label="Mês anterior">
        <svg class="ds-lucide ds-lucide--sm" viewBox="0 0 24 24" aria-hidden="true">
          <use href="/assets/gris/design_system/icons/lucide/sprite.svg#chevron-left"></use>
        </svg>
      </button>
      <span class="datepicker-popover__title" data-datepicker-title aria-live="polite"></span>
      <button type="button" class="datepicker-popover__nav" data-datepicker-next aria-label="Próximo mês">
        <svg class="ds-lucide ds-lucide--sm" viewBox="0 0 24 24" aria-hidden="true">
          <use href="/assets/gris/design_system/icons/lucide/sprite.svg#chevron-right"></use>
        </svg>
      </button>
    </header>
    <div class="datepicker-popover__weekdays" aria-hidden="true" data-datepicker-weekdays></div>
    <div class="datepicker-popover__grid" role="grid" data-datepicker-grid></div>
    <footer class="datepicker-popover__footer">
      <button type="button" class="datepicker-popover__action" data-datepicker-clear>Limpar</button>
      <button type="button" class="datepicker-popover__action" data-datepicker-today>Hoje</button>
    </footer>
  </div>
</div>
{% endmacro %}
