# Gris Docker Deployment - Environment Variables
# Copy this file to .env and adjust values

# --- App Image ---
CUSTOM_IMAGE=gris
CUSTOM_TAG=latest
PULL_POLICY=never

# --- Database ---
DB_PASSWORD=changeit

# --- Site ---
# Set to your site name (or $$host for host-based resolution)
FRAPPE_SITE_NAME_HEADER=gris.local

# --- Ports ---
HTTP_PUBLISH_PORT=8080

# --- Nginx ---
UPSTREAM_REAL_IP_ADDRESS=127.0.0.1
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=off
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m

# --- Restart Policy ---
RESTART_POLICY=unless-stopped

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_KEY=changeit
EVOLUTION_DOMAIN=evolution.gepim.com.br
EVOLUTION_PG_USER=evolution
EVOLUTION_PG_PASSWORD=changeit
EVOLUTION_PG_DB=evolution

# --- Outline (Wiki / Knowledge Base) ---
# Generate SECRET_KEY and UTILS_SECRET with: openssl rand -hex 32
OUTLINE_DOMAIN=outline.gepim.com.br
OUTLINE_SECRET_KEY=changeit
OUTLINE_UTILS_SECRET=changeit
OUTLINE_PG_USER=outline
OUTLINE_PG_PASSWORD=changeit
OUTLINE_PG_DB=outline
# Google OAuth: https://console.cloud.google.com/apis/credentials
# Redirect URI: https://outline.gepim.com.br/auth/google.callback
OUTLINE_GOOGLE_CLIENT_ID=changeit
OUTLINE_GOOGLE_CLIENT_SECRET=changeit
